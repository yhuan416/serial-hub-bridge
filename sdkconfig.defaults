# serial-hub-bridge defaults — Alientek ESP32-S3 (16 MB flash, 8 MB octal PSRAM,
# 160x80 ST7789 LCD). Adjust pins/partition for other boards.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000

# app_main blocks in the TCP session loop; give it room for JSON/base64 work.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 16 MB flash + a 4 MB factory app (NimBLE + network_provisioning + LCD/QR).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 8 MB octal PSRAM (ring/log/scratch prefer it, internal RAM fallback).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# NimBLE for network_provisioning (BLE provisioning transport).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=64
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=260
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_EXT_SCAN=y

# protocomm Security1 (X25519 + PoP + AES-CTR) used by the QR payload.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# Bridge / provisioning
CONFIG_BRIDGE_TCP_PORT=7000
CONFIG_BRIDGE_AUTH_TOKEN=""
CONFIG_BRIDGE_PROV_POP="abcd1234"
CONFIG_BRIDGE_PROV_BLE_PREFIX="PROV_"
CONFIG_BRIDGE_LCD_ENABLE=y
CONFIG_BRIDGE_BUTTON_ENABLE=y
CONFIG_BRIDGE_BUTTON_GPIO=0
CONFIG_BRIDGE_BUTTON_LONG_PRESS_MS=5000

# UART1 -> target (verified camera is 921600 8N1; host sends CONFIG at open).
CONFIG_BRIDGE_UART_NUM=1
CONFIG_BRIDGE_UART_TX_GPIO=17
CONFIG_BRIDGE_UART_RX_GPIO=18
CONFIG_BRIDGE_UART_RTS_GPIO=-1
CONFIG_BRIDGE_UART_CTS_GPIO=-1
CONFIG_BRIDGE_UART_DTR_GPIO=-1
CONFIG_BRIDGE_UART_BAUD=115200

CONFIG_BRIDGE_RING_BYTES=262144
CONFIG_BRIDGE_MAX_FRAME=32768
CONFIG_BRIDGE_MAX_HOLD_MS=10000

CONFIG_BRIDGE_LOG_ENTRIES=256
CONFIG_BRIDGE_LOG_LINE_MAX=192
CONFIG_BRIDGE_LOG_PARTIAL_MAX=1024